{
  "hosting": {
    "public": ".firebase-public",
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|otf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "search_index.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/federal-resume-builder-ai",
        "destination": "/tools-federal-resume",
        "type": 301
      },
      {
        "source": "/federal-resume-builder-ai.html",
        "destination": "/tools-federal-resume.html",
        "type": 301
      },
      {
        "source": "/linkedin-profile-rewriter",
        "destination": "/tools-linkedin-builder",
        "type": 301
      },
      {
        "source": "/linkedin-profile-rewriter.html",
        "destination": "/tools-linkedin-builder.html",
        "type": 301
      },
      {
        "source": "/salary-negotiation-roleplay",
        "destination": "/tools-salary-negotiator",
        "type": 301
      },
      {
        "source": "/salary-negotiation-roleplay.html",
        "destination": "/tools-salary-negotiator.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/404.html"
      }
    ]
  }
}
