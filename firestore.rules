rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin is identified by a custom claim set via the Admin SDK.
    // See scripts/set-admin-claim.mjs to grant it.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // User profiles + all subcollections (resumes, coverLetters, emails, scores).
    // Only the authenticated owner can read/write their own data.
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public, shareable veteran profiles (opt-in "digital CV"). World-readable BY
    // DESIGN: the Vercel proxy server-renders these so a shared link shows a real
    // social preview card. Only SANITIZED, owner-chosen fields are ever written here
    // (contact info only if the vet toggles it on; NEVER disability ratings or VA
    // claim data). Only the owner (uid) may create/update/delete their own profile.
    match /publicProfiles/{slug} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 120;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Email capture / lead gen. Anonymous visitors may submit (the signup gate runs
    // before login), but only an admin may read, edit, or delete the subscriber list.
    match /email_subscribers/{doc} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 254;
      allow read, update, delete: if isAdmin();
    }

    // Legacy community collections. Currently unused by the app; previously they were
    // world-readable AND world-writable (create: if true), which allowed anonymous
    // stored-content injection and cost abuse. Locked to admin only. If a public
    // submission feature is built later, loosen deliberately with an ownerId model:
    //   allow create: if request.auth != null
    //                 && request.resource.data.ownerId == request.auth.uid && <field validation>;
    //   allow update, delete: if isAdmin()
    //                 || (request.auth != null && resource.data.ownerId == request.auth.uid);
    match /stories/{docId}        { allow read, write: if isAdmin(); }
    match /successStories/{docId} { allow read, write: if isAdmin(); }
    match /salaries/{docId}       { allow read, write: if isAdmin(); }
    match /salaryData/{docId}     { allow read, write: if isAdmin(); }
  }
}
